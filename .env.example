# App Environment Configuration
# Copy this file to .env and adjust values as needed

# Production Server (WebSocket für Echtzeit-Positionen)
POSITIONING_WS_URL=wss://railtrail.rtsys.informatik.uni-kiel.de/api/position-updates

# Local Development (uncomment for local testing)
# POSITIONING_WS_URL=ws://localhost:5010/position-updates

# API Timeout in milliseconds
API_TIMEOUT=3000

# Map Tile Server (OpenFreeMap - free, no API key required)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
FEEDBACK_URL=https://example.com/api/feedback
# Feedback API Endpoint (optional - if not set, feedback will not be sent)

# Track file to load (dev-dummy | malente-luetjenburg)
TRACK_FILE=malente-luetjenburg

# Demo/Lokal-Fahrzeuge in der Fahrzeugauswahl anzeigen (true | false). Default: false (versteckt).
ENABLE_DEMO_MODE=false
